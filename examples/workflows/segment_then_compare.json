{
  "version": 1,
  "name": "Segment, then compare A vs B",
  "steps": [
    {
      "type": "find_spatial_features",
      "title": "Find spatial features",
      "params": {
        "snr": 3.0,
        "min_rel_intensity": 0.002,
        "min_frequency": 0.01,
        "min_morans": 0.05,
        "tol_ppm": 10.0,
        "norm": "tic"
      },
      "scope": {},
      "enabled": true
    },
    {
      "type": "auto_segment",
      "title": "Segment tissue",
      "params": {
        "n_clusters": 0,
        "spatial": true,
        "spatial_sigma": 1.0,
        "tol_ppm": 50.0,
        "norm": "tic"
      },
      "scope": {},
      "enabled": true
    },
    {
      "type": "roi_comparison",
      "title": "Compare Group A vs B",
      "params": {
        "method": "mwu",
        "tol_ppm": 10.0,
        "norm": "tic"
      },
      "scope": {},
      "enabled": true
    },
    {
      "type": "annotate",
      "title": "Identify lipids",
      "params": {
        "mode": "negative",
        "match_ppm": 10.0,
        "image_ppm": 10.0,
        "norm": "tic"
      },
      "scope": {},
      "enabled": true
    }
  ],
  "target": "slide",
  "scope_region": "",
  "on_error": "stop",
  "log_to_report": true,
  "export_bundle": true,
  "rep_top_n": 15,
  "bundle_dir": ""
}
